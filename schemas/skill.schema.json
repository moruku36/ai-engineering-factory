{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-factory/schemas/skill.schema.json",
  "title": "AgentSkill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "input",
    "precondition",
    "steps",
    "command_ids",
    "output",
    "validation",
    "failure",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2020-12"
    },
    "id": {
      "type": "string",
      "pattern": "^SKILL-[0-9]{3,6}$"
    },
    "name": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "precondition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": true
    },
    "validation": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
