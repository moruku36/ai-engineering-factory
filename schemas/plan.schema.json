{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-factory/schemas/plan.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "target_repo",
    "requested_phase",
    "task_refs",
    "max_workers",
    "max_wall_seconds",
    "approved_scope_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2020-12"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{4,8}$"
    },
    "target_repo": {
      "type": "string",
      "minLength": 1
    },
    "requested_phase": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "task_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,6}$"
      }
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "max_wall_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "approved_scope_ref": {
      "type": "string"
    }
  }
}
